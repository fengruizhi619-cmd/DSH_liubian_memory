{
  "name": "dsh-liubian-notes",
  "version": "0.4.1",
  "description": "流变·便签 —— 流变系统的短期记忆子系统：会话内便签池（自动聚合 + 主动挂起），向量唯一检索，热度 l/m，赛马淘汰，晋级缓存制；对话内「流变便签」栏卡片可视化",
  "private": true,
  "type": "module",
  "main": "./lib/main.mjs",
  "exports": {
    ".": "./lib/main.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "liubian",
    "notes",
    "short-term-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
